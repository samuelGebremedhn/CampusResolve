/**
 * Utkal University — International Office Complaint Portal
 * Backend: Google Apps Script, bound to a Google Sheet.
 *
 * SETUP (see README.md for full steps):
 *   1. Create a new Google Sheet.
 *   2. Extensions > Apps Script. Paste this file, plus Index.html and Admin.html.
 *   3. Run the `setup` function once (select it in the toolbar dropdown, click Run).
 *   4. Deploy > New deployment > Web app > Execute as "Me", Who has access "Anyone".
 *   5. Share the resulting URL with students. Add "?view=admin" for the office dashboard.
 */

const SHEET_NAME = 'Complaints';
const HEADERS = [
  'Complaint ID', 'Timestamp', 'Full Name', 'Student ID', 'Country',
  'Program/Department', 'Email', 'Phone', 'Category', 'Urgency',
  'Description', 'Status', 'Office Notes', 'Last Updated',
  'Evidence File Name', 'Evidence File URL', 'Student Response', 'Follow-up Note'
];

// ---------- Anti-abuse limits ----------
// Tune these to your expected volume and your Google account's mail quota.
const MAX_PER_EMAIL_PER_HOUR = 5;   // stops one address from flooding the sheet/mailbox
const MAX_TOTAL_PER_DAY = 150;      // stays safely under a typical ~100-500/day mail quota
const MAX_EVIDENCE_BYTES = 10 * 1024 * 1024;
const EVIDENCE_FOLDER_NAME = 'Utkal University Complaint Evidence';
const LOGO_BASE64 = '';


// ---------- One-time setup ----------
function setup() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(SHEET_NAME);
  if (!sheet) sheet = ss.insertSheet(SHEET_NAME);

  // Create or migrate the header row without disturbing existing complaints.
  const currentHeaders = sheet.getLastColumn() ? sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0] : [];
  if (sheet.getLastRow() === 0) {
    sheet.getRange(1, 1, 1, HEADERS.length).setValues([HEADERS]);
    sheet.setFrozenRows(1);
  } else {
    HEADERS.forEach(function(header, i) {
      if (currentHeaders[i] !== header) sheet.getRange(1, i + 1).setValue(header);
    });
    sheet.setFrozenRows(1);
  }

  const props = PropertiesService.getScriptProperties();
  if (!props.getProperty('ADMIN_KEY')) props.setProperty('ADMIN_KEY', 'change-me-now');
  if (!props.getProperty('OFFICE_EMAIL')) props.setProperty('OFFICE_EMAIL', Session.getActiveUser().getEmail());

  Logger.log('Setup complete. Admin key is: %s (change this in Project Settings > Script Properties)', props.getProperty('ADMIN_KEY'));
}


// ---------- Web app entry point ----------
function doGet(e) {
  const view = (e && e.parameter && e.parameter.view) || 'form';
  const template = HtmlService.createTemplateFromFile(view === 'admin' ? 'Admin' : 'Index');
  return template.evaluate()
    .setTitle('Utkal University — International Office Complaint Portal')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function include(filename) {
  return HtmlService.createHtmlOutputFromFile(filename).getContent();
}

// ---------- Sheet helper ----------
function getSheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(SHEET_NAME);
  if (!sheet) throw new Error('Sheet not found — run setup() first.');
  return sheet;
}

function nextComplaintId_(sheet) {
  const year = new Date().getFullYear();
  const rowNum = sheet.getLastRow(); // header occupies row 1, so this is next sequence number
  return 'UU-' + year + '-' + ('0000' + rowNum).slice(-4);
}

// ---------- Anti-abuse: honeypot + rate limiting ----------
// isRateLimited_ returns a user-facing message if the submission should be
// blocked, or null if it's allowed to proceed.
function isRateLimited_(email) {
  const props = PropertiesService.getScriptProperties();
  const tz = Session.getScriptTimeZone() || 'Etc/UTC';
  const today = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');

  // Daily total cap (persists across the day via Script Properties;
  // CacheService can't hold a value for a full 24h so it's not used here).
  let dayCount = Number(props.getProperty('RL_DAY_COUNT') || 0);
  if (props.getProperty('RL_DAY') !== today) {
    dayCount = 0;
    props.setProperty('RL_DAY', today);
  }
  if (dayCount >= MAX_TOTAL_PER_DAY) {
    return 'The portal has reached its submission limit for today. Please try again tomorrow, or contact the International Office directly if this is urgent.';
  }

  // Per-email hourly cap (CacheService, 1h TTL — well under its 6h max).
  const cache = CacheService.getScriptCache();
  const hourKey = 'cnt_' + email;
  const hourCount = Number(cache.get(hourKey) || 0);
  if (hourCount >= MAX_PER_EMAIL_PER_HOUR) {
    return 'Too many submissions from this email address recently. Please wait a while before submitting again.';
  }

  cache.put(hourKey, String(hourCount + 1), 3600);
  props.setProperty('RL_DAY_COUNT', String(dayCount + 1));
  return null;
}

// ---------- Public: submit a complaint ----------
function submitComplaint(data) {
  if (!data || !data.fullName || !data.email || !data.phone || !data.description) {
    return { success: false, message: 'Please fill in all required fields, including your phone number.' };
  }

  if (data.hp_ref9x) return { success: true, complaintId: 'UU-0000' };

  const limitMsg = isRateLimited_(String(data.email).trim().toLowerCase());
  if (limitMsg) return { success: false, message: limitMsg };

  const sheet = getSheet_();
  const id = nextComplaintId_(sheet);
  const now = new Date();

  let evidence = { name: '', url: '' };
  if (data.evidence && data.evidence.base64) {
    evidence = saveEvidence_(id, data.evidence);
  }

  // Keep compatibility with the existing first 14 columns and add the new fields.
  sheet.appendRow([
    id, now, data.fullName, data.studentId || '', data.country || '',
    data.program || '', data.email, data.phone,
    data.category || 'Other', data.urgency || 'Medium',
    data.description, 'New', '', now,
    evidence.name, evidence.url, '', ''
  ]);

  try {
    MailApp.sendEmail(data.email,
      'Complaint received — ' + id,
      'Dear ' + data.fullName + ',\n\n' +
      'Your complaint has been received by the International Office.\n\n' +
      'Reference ID: ' + id + '\nCategory: ' + (data.category || 'Other') +
      '\nUrgency: ' + (data.urgency || 'Medium') + '\n\n' +
      'Please keep this reference ID — you can use it with your email address to check the status of your complaint at any time.\n\n' +
      '— International Office, Utkal University'
    );
    const officeEmail = PropertiesService.getScriptProperties().getProperty('OFFICE_EMAIL');
    if (officeEmail) {
      MailApp.sendEmail(officeEmail,
        'New complaint — ' + id + ' (' + (data.urgency || 'Medium') + ' priority)',
        'A new complaint was submitted.\n\n' +
        'ID: ' + id + '\nName: ' + data.fullName + '\nPhone: ' + data.phone +
        '\nCountry: ' + (data.country || '') + '\nCategory: ' + (data.category || 'Other') +
        '\nUrgency: ' + (data.urgency || 'Medium') +
        (evidence.url ? '\nEvidence: ' + evidence.url : '') +
        '\n\nDescription:\n' + data.description
      );
    }
  } catch (err) {}

  return { success: true, complaintId: id };
}

function saveEvidence_(complaintId, evidence) {
  const allowed = {
    'application/pdf': '.pdf',
    'image/jpeg': '.jpg',
    'image/png': '.png',
    'image/webp': '.webp'
  };
  const mime = String(evidence.mimeType || '').toLowerCase();
  if (!allowed[mime]) throw new Error('Evidence must be a PDF, JPG, PNG, or WebP image.');

  const raw = String(evidence.base64 || '').replace(/^data:[^,]+,/, '');
  const bytes = Utilities.base64Decode(raw);
  if (bytes.length > MAX_EVIDENCE_BYTES) throw new Error('Evidence file is too large. Maximum size is 10 MB.');

  const folder = getEvidenceFolder_();
  const safeName = String(evidence.name || 'evidence').replace(/[^a-zA-Z0-9._-]/g, '_');
  const file = folder.createFile(Utilities.newBlob(bytes, mime, complaintId + '_evidence_' + safeName));
  // Keep evidence private; access is mediated by the authenticated admin portal.
  try { file.setSharing(DriveApp.Access.PRIVATE, DriveApp.Permission.VIEW); } catch (e) {}
  return { name: file.getName(), url: file.getUrl() };
}

function getEvidenceFolder_() {
  const props = PropertiesService.getScriptProperties();
  const existingId = props.getProperty('EVIDENCE_FOLDER_ID');
  if (existingId) {
    try { return DriveApp.getFolderById(existingId); } catch (e) {}
  }
  const folders = DriveApp.getFoldersByName(EVIDENCE_FOLDER_NAME);
  const folder = folders.hasNext() ? folders.next() : DriveApp.createFolder(EVIDENCE_FOLDER_NAME);
  props.setProperty('EVIDENCE_FOLDER_ID', folder.getId());
  return folder;
}


// ---------- Public: check status ----------
function checkStatus(complaintId, email) {
  const sheet = getSheet_();
  const values = sheet.getDataRange().getValues();
  for (let i = 1; i < values.length; i++) {
    const row = values[i];
    if (String(row[0]).trim() === String(complaintId).trim() &&
        String(row[6]).trim().toLowerCase() === String(email).trim().toLowerCase()) {
      return {
        found: true, id: String(row[0] || ''), status: String(row[11] || 'New'),
        category: String(row[8] || ''), urgency: String(row[9] || ''),
        lastUpdated: formatDate_(row[13]), notes: String(row[12] || ''),
        evidenceName: String(row[14] || ''),
        studentResponse: String(row[16] || ''), followupNote: String(row[17] || '')
      };
    }
  }
  return { found: false };
}

function studentResolutionResponse(complaintId, email, action, note) {
  const sheet = getSheet_();
  const values = sheet.getDataRange().getValues();
  for (let i = 1; i < values.length; i++) {
    const row = values[i];
    if (String(row[0]).trim() === String(complaintId).trim() &&
        String(row[6]).trim().toLowerCase() === String(email).trim().toLowerCase()) {
      if (String(row[11]) !== 'Resolved') return { success: false, message: 'This complaint is not currently marked as resolved.' };
      const rowNum = i + 1;
      const cleanNote = String(note || '').trim();
      if (action === 'confirm') {
        sheet.getRange(rowNum, 17).setValue('Resolution Confirmed');
        sheet.getRange(rowNum, 18).setValue('');
        sheet.getRange(rowNum, 14).setValue(new Date());
      } else if (action === 'followup') {
        if (!cleanNote) return { success: false, message: 'Please describe what still needs attention.' };
        sheet.getRange(rowNum, 12).setValue('Follow-up Requested');
        sheet.getRange(rowNum, 17).setValue('Follow-up Requested');
        sheet.getRange(rowNum, 18).setValue(cleanNote);
        sheet.getRange(rowNum, 14).setValue(new Date());

        const officeEmail = PropertiesService.getScriptProperties().getProperty('OFFICE_EMAIL');
        if (officeEmail) {
          try {
            MailApp.sendEmail(officeEmail, 'Follow-up requested — ' + row[0],
              'A student has requested follow-up on a complaint marked resolved.\n\n' +
              'ID: ' + row[0] + '\nStudent: ' + row[2] + '\nEmail: ' + row[6] +
              '\n\nFollow-up request:\n' + cleanNote);
          } catch (e) {}
        }
      } else {
        return { success: false, message: 'Invalid response.' };
      }
      return { success: true, status: action === 'followup' ? 'Follow-up Requested' : 'Resolved' };
    }
  }
  return { success: false, message: 'Complaint not found.' };
}

function formatDate_(value) {
  if (value instanceof Date) return Utilities.formatDate(value, Session.getScriptTimeZone() || 'Asia/Kolkata', 'yyyy-MM-dd HH:mm:ss');
  return String(value || '');
}


// ---------- Admin authentication ----------
// The password is accepted only by loginAdmin_ and is never used in the URL.
// A short-lived random session token is used for subsequent admin calls.
const ADMIN_SESSION_TTL = 1800; // 30 minutes

function loginAdmin(adminKey) {
  const key = PropertiesService.getScriptProperties().getProperty('ADMIN_KEY');
  if (!adminKey || !key || adminKey !== key) throw new Error('Invalid office passcode.');

  const token = Utilities.getUuid() + Utilities.getUuid();
  CacheService.getScriptCache().put('admin_session_' + token, '1', ADMIN_SESSION_TTL);
  return { success: true, token: token, expiresIn: ADMIN_SESSION_TTL };
}

function logoutAdmin(token) {
  if (token) CacheService.getScriptCache().remove('admin_session_' + token);
  return { success: true };
}

function checkAdminSession_(token) {
  if (!token || CacheService.getScriptCache().get('admin_session_' + token) !== '1') {
    throw new Error('Admin session expired. Please sign in again.');
  }
}

// ---------- Admin: list complaints ----------
function getComplaints(sessionToken) {
  checkAdminSession_(sessionToken);
  const sheet = getSheet_();
  const values = sheet.getDataRange().getValues();
  const rows = [];
  for (let i = 1; i < values.length; i++) {
    const r = values[i];
    rows.push({
      id: String(r[0] || ''), timestamp: formatDate_(r[1]), fullName: String(r[2] || ''), studentId: String(r[3] || ''), country: String(r[4] || ''),
      program: String(r[5] || ''), email: String(r[6] || ''), phone: String(r[7] || ''), category: String(r[8] || 'Other'), urgency: String(r[9] || 'Medium'),
      description: String(r[10] || ''), status: String(r[11] || 'New'), notes: String(r[12] || ''), lastUpdated: formatDate_(r[13]),
      evidenceName: String(r[14] || ''), evidenceUrl: String(r[15] || ''), studentResponse: String(r[16] || ''), followupNote: String(r[17] || ''), row: i + 1
    });
  }
  return rows.reverse();
}


// ---------- Admin: update a complaint ----------
function updateComplaintStatus(sessionToken, rowNum, newStatus, note) {
  checkAdminSession_(sessionToken);
  const sheet = getSheet_();
  const allowed = ['New', 'In Progress', 'Resolved', 'Follow-up Requested'];
  if (allowed.indexOf(newStatus) === -1) throw new Error('Invalid status.');
  sheet.getRange(rowNum, 12).setValue(newStatus);
  if (note) sheet.getRange(rowNum, 13).setValue(note);
  sheet.getRange(rowNum, 14).setValue(new Date());

  const email = sheet.getRange(rowNum, 7).getValue();
  const id = sheet.getRange(rowNum, 1).getValue();
  if (email) {
    try {
      MailApp.sendEmail(email, 'Update on your complaint — ' + id,
        'Your complaint status has been updated to: ' + newStatus +
        (note ? ('\n\nNote from the International Office:\n' + note) : '') +
        '\n\n— International Office, Utkal University');
    } catch (err) {}
  }
  return { success: true };
}

function getEvidenceFile(sessionToken, rowNum) {
  checkAdminSession_(sessionToken);
  const sheet = getSheet_();
  const r = sheet.getRange(rowNum, 15, 1, 2).getValues()[0];
  const name = String(r[0] || 'Evidence');
  const url = String(r[1] || '');
  if (!url) throw new Error('No evidence file is attached to this complaint.');
  const match = url.match(/[-\w]{20,}/);
  if (!match) throw new Error('The evidence file reference is invalid.');
  const file = DriveApp.getFileById(match[0]);
  const blob = file.getBlob();
  return { filename: name, mimeType: blob.getContentType(), base64: Utilities.base64Encode(blob.getBytes()) };
}

function appendReportSection_(body, title, content, options) {
  const text = String(content || '').trim();
  if (!text) return;

  const heading = body.appendParagraph(String(title || ''));
  heading.setFontSize(10).setBold(true).setForegroundColor('#0B1F3A');
  heading.setSpacingBefore(9).setSpacingAfter(4);

  const table = body.appendTable([[text]]);
  const cell = table.getRow(0).getCell(0);
  cell.setBackgroundColor((options && options.background) || '#F7F9FC');
  cell;
  cell.editAsText().setFontSize(9).setForegroundColor('#253449');
}

function appendReportInfoTable_(body, r) {
  const rows = [
    ['Student name', String(r[2] || 'Not provided'), 'Phone number', String(r[7] || 'Not provided')],
    ['Student ID', String(r[3] || 'Not provided'), 'Country', String(r[4] || 'Not provided')],
    ['Program / Department', String(r[5] || 'Not provided'), 'Case type', String(r[8] || 'Not provided')],
    ['Email', String(r[6] || 'Not provided'), 'Urgency', String(r[9] || 'Not provided')],
    ['Status', String(r[11] || 'Not provided'), 'Complaint ID', String(r[0] || 'Not provided')],
    ['Submitted', formatDate_(r[1]), 'Last updated', formatDate_(r[13])]
  ];
  const table = body.appendTable(rows);
  for (let i = 0; i < table.getNumRows(); i++) {
    const row = table.getRow(i);
    const labelA = row.getCell(0);
    const valueA = row.getCell(1);
    const labelB = row.getCell(2);
    const valueB = row.getCell(3);
    labelA.setBackgroundColor('#EAF0F7');
    labelB.setBackgroundColor('#EAF0F7');
    valueA.setBackgroundColor('#FFFFFF');
    valueB.setBackgroundColor('#FFFFFF');
    labelA;
    valueA;
    labelB;
    valueB;
    labelA.editAsText().setBold(true).setFontSize(8).setForegroundColor('#0B1F3A');
    labelB.editAsText().setBold(true).setFontSize(8).setForegroundColor('#0B1F3A');
    valueA.editAsText().setFontSize(8.5).setForegroundColor('#253449');
    valueB.editAsText().setFontSize(8.5).setForegroundColor('#253449');
  }
  return table;
}

function appendReportHeader_(body, title, subtitle) {
  const logoBlob = Utilities.newBlob(
    Utilities.base64Decode(LOGO_BASE64),
    'image/png',
    'Utkal_University_International_Office_Logo.png'
  );
  const logo = body.appendImage(logoBlob);
  logo.setWidth(430);
  logo.setHeight(Math.round(430 * 299 / 757));
  logo.getParent().asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER);

  const dashboard = body.appendParagraph('International Student Complaint Dashboard');
  dashboard.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
  dashboard.setFontSize(9).setBold(true).setForegroundColor('#5B6675');
  dashboard.setSpacingAfter(7);

  const heading = body.appendParagraph(title);
  heading.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
  heading.setFontSize(15).setBold(true).setForegroundColor('#0B1F3A');
  heading.setSpacingAfter(3);

  const sub = body.appendParagraph(subtitle || '');
  sub.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
  sub.setFontSize(8.5).setForegroundColor('#5B6675');
  sub.setSpacingAfter(10);

  body.appendHorizontalRule();
}

function appendCaseToReport_(body, r, index, total, includePageBreak) {
  if (includePageBreak) body.appendPageBreak();

  const caseHeading = body.appendParagraph((index + 1) + '  |  ' + String(r[0] || 'Complaint'));
  caseHeading.setFontSize(13).setBold(true).setForegroundColor('#0B1F3A');
  caseHeading.setSpacingAfter(3);

  const status = body.appendParagraph('STATUS: ' + String(r[11] || 'New').toUpperCase() + '   •   URGENCY: ' + String(r[9] || 'Medium').toUpperCase());
  status.setFontSize(8.5).setBold(true).setForegroundColor('#B9973E');
  status.setSpacingAfter(7);

  appendReportInfoTable_(body, r);
  appendReportSection_(body, 'Complaint description', r[10], { background: '#F7F9FC' });
  appendReportSection_(body, 'Office notes', r[12], { background: '#FFF8E2' });
  appendReportSection_(body, 'Student response', r[16], { background: '#EEF8F1' });
  appendReportSection_(body, 'Follow-up request', r[17], { background: '#FFF3E8' });
  appendReportSection_(body, 'Evidence file', r[14], { background: '#F3F5F8' });

  const marker = body.appendParagraph('Utkal University • International Office • International Student Complaint Dashboard');
  marker.setFontSize(7).setForegroundColor('#8A94A3');
  marker.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
  marker.setSpacingBefore(10);
}

function createPdfFromDoc_(doc, filename) {
  doc.saveAndClose();
  const file = DriveApp.getFileById(doc.getId());
  const pdf = file.getAs(MimeType.PDF);
  const result = {
    filename: filename,
    mimeType: MimeType.PDF,
    base64: Utilities.base64Encode(pdf.getBytes())
  };
  file.setTrashed(true);
  return result;
}

function generateComplaintReport(sessionToken, rowNum) {
  checkAdminSession_(sessionToken);
  const sheet = getSheet_();
  const r = sheet.getRange(rowNum, 1, 1, Math.max(sheet.getLastColumn(), HEADERS.length)).getValues()[0];
  if (!r[0]) throw new Error('Complaint not found.');

  const doc = DocumentApp.create('Complaint Report - ' + r[0]);
  const body = doc.getBody();
  body.setMarginTop(34).setMarginBottom(34).setMarginLeft(42).setMarginRight(42);
  appendReportHeader_(body, 'COMPLAINT REPORT', 'Reference ID: ' + String(r[0]) + '  •  Generated: ' + formatDate_(new Date()));
  appendCaseToReport_(body, r, 0, 1, false);
  return createPdfFromDoc_(doc, 'Complaint_Report_' + r[0] + '.pdf');
}

// ---------- Admin: combined PDF reports ----------
function generateCasesReport(sessionToken, solved) {
  checkAdminSession_(sessionToken);
  const sheet = getSheet_();
  const values = sheet.getDataRange().getValues();
  const cases = [];
  for (let i = 1; i < values.length; i++) {
    const r = values[i];
    const status = String(r[11] || 'New');
    if (solved ? status === 'Resolved' : status !== 'Resolved') {
      cases.push({ row: i + 1, data: r });
    }
  }

  const title = solved ? 'SOLVED CASE REPORT' : 'UNSOLVED CASE REPORT';
  const stamp = formatDate_(new Date());
  const doc = DocumentApp.create('Utkal University - ' + title + ' - ' + stamp.replace(/[: ]/g, '-'));
  const body = doc.getBody();
  body.setMarginTop(34).setMarginBottom(34).setMarginLeft(42).setMarginRight(42);
  appendReportHeader_(body, title, 'Generated: ' + stamp + '  •  Total cases: ' + cases.length);

  if (!cases.length) {
    const empty = body.appendParagraph(solved ? 'There are no solved cases at this time.' : 'There are no unsolved cases at this time.');
    empty.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
    empty.setFontSize(11).setForegroundColor('#5B6675');
    empty.setSpacingBefore(30);
  } else {
    cases.forEach(function(item, index) {
      appendCaseToReport_(body, item.data, index, cases.length, index > 0);
    });
  }

  const filename = (solved ? 'Solved_case_report_' : 'Unsolved_case_report_') +
    Utilities.formatDate(new Date(), Session.getScriptTimeZone() || 'Asia/Kolkata', 'yyyyMMdd_HHmmss') + '.pdf';
  return createPdfFromDoc_(doc, filename);
}

function generateUnsolvedCasesReport(sessionToken) {
  return generateCasesReport(sessionToken, false);
}

function generateSolvedCasesReport(sessionToken) {
  return generateCasesReport(sessionToken, true);
}
